   "source": [
    "import numpy as np\n",
    "np.random.seed(1)\n",
    "arr=np.random.randint(1,50,10)\n",
    "print(arr)\n",
    "x=np.sort(arr)\n",
    "print(x)\n",
    "print(arr)\n",
    "y=arr.sort()\n",
    "print(y)\n",
    "print(arr)\n",
    "i=np.argsort(arr)\n",
    "z=x[i]\n",
    "print(i)\n",
    "print(z)"
   ]
